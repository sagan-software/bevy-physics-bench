      "css": ".ds-sample{font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:#253039}.ds-field{font:inherit;font-size:.875rem}.ds-field{border:1px solid #b9c4bd;border-radius:5px;background:#fff;color:inherit;min-height:36px}.ds-field{font:inherit;font-size:.875rem}.ds-label{display:flex;flex-direction:column;gap:6px;font-size:.8125rem;font-weight:550}.ds-field[type=number]{font-variant-numeric:tabular-nums}.ds-field:focus-visible{outline:3px solid var(--focus,#176d9b);outline-offset:3px}"
    },
    {
      "name": "Main navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Current route uses teal text and a bottom border.",
      "html": "<div class=\"ds-sample\"><nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#playground\" aria-current=\"page\">Playground</a><a href=\"#results\">Results</a><a href=\"#method\">Method</a></nav></div>",
      "css": ".ds-sample{font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:#253039}.ds-nav a{color:var(--accent,#216b5e);text-underline-offset:3px}.ds-nav{display:flex;align-self:stretch;gap:27px}.ds-nav a{display:flex;align-items:center;text-decoration:none;color:var(--muted,#5e6a70);font-size:.875rem;border-bottom:2px solid transparent;padding-top:2px}.ds-nav a[aria-current=page]{color:var(--accent,#216b5e);border-color:var(--accent,#216b5e);font-weight:650}.ds-nav a:focus-visible{outline:3px solid var(--focus,#176d9b);outline-offset:3px}"
    },
    {
      "name": "Scene navigation",
      "kind": "nav",
      "refersTo": "scene-current",
      "description": "Selected scene uses a tinted row.",
      "html": "<div class=\"ds-sample\"><nav class=\"ds-scenes\" aria-label=\"Benchmark scenes\"><h2>Benchmarks</h2><button aria-current=\"true\">Pyramid</button><button>Box pile</button><button>Ball pit</button></nav></div>",
      "css": ".ds-sample{font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:#253039}.ds-scenes button{font:inherit;font-size:.875rem}.ds-scenes button{border:1px solid #b9c4bd;border-radius:5px;background:#fff;color:inherit;min-height:36px}.ds-scenes button{padding:7px 12px;cursor:pointer;font-weight:550}.ds-scenes button:hover:not(:disabled){background:#eaf0ec;border-color:#8d9e93}.ds-scenes{padding:28px 12px 30px 18px;border-right:1px solid var(--line,#d9dfdc);background:#f0f3ef}.ds-scenes h2{font-size:.875rem;margin:0 10px 26px}.ds-scenes button{display:block;width:100%;text-align:left;border:0;background:transparent;font-weight:450;padding:9px 11px;font-size:.8125rem}.ds-scenes button[aria-current=true]{color:#174f43;background:#dcebe1;font-weight:650}.ds-scenes button:focus-visible{outline:3px solid var(--focus,#176d9b);outline-offset:3px}"
    },
    {
      "name": "Simulation container",
      "kind": "custom",
      "refersTo": "simulation",
      "description": "Static loading state of the implemented single-view shell; no simulation runtime is included.",
      "html": "<div class=\"ds-sample\"><div class=\"ds-views\" data-single=\"true\"><section><div class=\"ds-view-toolbar\"><label><span class=\"ds-engine-dot\" aria-hidden=\"true\"></span>Engine A<select aria-label=\"Engine A\"><option>Avian</option><option>Rapier</option></select></label><span class=\"ds-version\">0.7.0</span></div><div class=\"ds-stage\"><p class=\"ds-loading\">Loading WebAssembly…</p></div><div class=\"ds-view-footer\"><span>Ready</span></div></section></div></div>",
      "css": ".ds-sample{font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:#253039}.ds-views{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border:1px solid #cad3cd;border-radius:7px;overflow:hidden;background:#14212b}.ds-views[data-single=true]{grid-template-columns:1fr}.ds-view-toolbar{display:flex;justify-content:space-between;align-items:center;background:#fff;gap:7px;height:56px;padding:0 13px}.ds-view-toolbar label{display:flex;flex-direction:column;gap:6px;font-size:.8125rem;font-weight:550}.ds-view-toolbar label{min-width:0;flex:1;flex-direction:row;align-items:center;gap:7px;white-space:nowrap;font-size:.75rem}.ds-view-toolbar select{font:inherit;font-size:.875rem}.ds-view-toolbar select{border:1px solid #b9c4bd;border-radius:5px;background:#fff;color:inherit;min-height:36px}.ds-view-toolbar select{font:inherit;font-size:.875rem}.ds-view-toolbar select{min-width:0;width:100%;flex:1;border:0;background:#f1f4f1;font-size:.8125rem;font-weight:650;padding:6px 22px 6px 7px}.ds-engine-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#257d66}.ds-version{flex-shrink:0;font-size:.6875rem;font-variant-numeric:tabular-nums;color:var(--muted,#5e6a70)}.ds-stage{height:390px;position:relative;overflow:hidden}.ds-loading{padding:30px;color:#d1dce1;font-size:.875rem}.ds-view-footer{display:flex;justify-content:space-between;gap:6px;background:#192a35;color:#c5d3db;font-size:.6875rem;padding:10px 13px;font-variant-numeric:tabular-nums}.ds-view-toolbar select:focus-visible{outline:3px solid var(--focus,#176d9b);outline-offset:3px}"
    },
    {
      "name": "Error alert",
      "kind": "custom",
      "refersTo": "error",
      "description": "Alert style; runtime supplies the failure detail.",
      "html": "<div class=\"ds-sample\"><div class=\"ds-error\" role=\"alert\">Comparison failed.</div></div>",
      "css": ".ds-sample{font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:#253039}.ds-error{background:#fff0e9;color:#873a22;padding:13px;border:1px solid #e2b6a5;border-radius:5px;font-size:.8125rem;line-height:1.5;margin:12px 0}"
    }
  ],
  "narrative": {
    "northStar": "Physics workbench",
    "overview": "The interface gives Bevy developers direct access to scenes, engine selection, playback, settings, and measured results. A light application frame separates readable controls from dark simulation stages. Compact labels and tabular measurements support comparison without decorative panels.\n\nThe user directed this restrained application through the code-led Operate workflow. The confirmed direction has no concept roll or FORM seed. The playground's composition belongs to `.impeccable/surfaces/playground.md`; its exact layout is not a rule for every future page.",
    "keyCharacteristics": [
      "Light controls around dark simulations.",
      "Engine names accompany engine colors.",
      "Borders and spacing separate tasks.",
      "Simulation provides the visible motion."
    ],
    "rules": [
      {
        "name": "The engine identity rule",
        "body": "Keep the engine name visible wherever color identifies an engine.",
        "section": "colors"
      },
      {
        "name": "The flat controls rule",
        "body": "Separate application controls with tones, borders, and spacing; preserve the dark simulation stage.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve visible engine names beside engine colors.",
      "Do keep numeric measurements tabular and retain runtime, version, and sampling context.",
      "Do keep keyboard focus visible on controls, links, summaries, and canvases.",
      "Do preserve the playground's mobile playback order and reachable scene selector."
    ],
    "donts": [
      "Don't add promotional copy, decorative animation, or nested panels to the workbench.",
      "Don't present unavailable adapters or empty result states as measured results.",
      "Don't turn playground column widths or stage heights into layout rules for every page.",
      "Don't use generated tonal ramps as implemented tokens without an approved design change."
    ]
  }
}
